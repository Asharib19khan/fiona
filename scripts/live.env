# Settings for running the real (live) Fiona from a fresh clone. Committed on purpose:
# nothing here is secret. pnpm dev copies any missing value into the root .env.local.
# Includes the admin key for the competition test project (owner's decision, 20 Oct 2026).
# Never put the database password here.
NEXT_PUBLIC_API_MODE=live
FIONA_MODE=live
# The demo business data runs to 22 Oct 2026; the engine clock is pinned to it.
FIONA_NOW=2026-10-22T09:00:00Z
FIONA_LLM_PROVIDER=claude_cli
DEMO_TENANT_ID=ten_karachi_apparel
LLM_RUN_BUDGET_USD=2
NEXT_PUBLIC_SUPABASE_URL=https://aiyzwlzbmzzxsvpifvoi.supabase.co
# Supabase publishable key: public by design, protected by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_VbstLqh8_mDc1Wb1TFlgKQ_akz2mAII
# Super admin (Accounts page) for the competition test project.
SUPER_ADMIN_EMAIL=ashepic057@gmail.com
SUPABASE_SERVICE_ROLE_KEY=sb_secret_EC_KC61sn-BpGohQVpzJKA_m_otNFWR
