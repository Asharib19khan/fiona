# Fiona environment template (S2). Copy to .env.local at the repo root and fill in what you need.
# NEVER commit .env.local and never paste a secret into chat, an issue or a PR (R16).
# A fresh clone needs NO values: everything runs in mock mode. `pnpm doctor` checks your
# .env.local without printing values. Live mode needs every variable marked `required: live`.
# Generated from scripts/lib/env-spec.mjs by `pnpm gen:env`; CI checks the two match.

# ── Modes ───────────────────────────────────────────────────────────────────
# not secret · used by: web · deployed in: Vercel · default: mock
# Inlined at build time. Previews build in mock mode; the demo build is live.
NEXT_PUBLIC_API_MODE=
# not secret · used by: engine · deployed in: Fly (fiona-engine) · default: mock
FIONA_MODE=
# not secret · used by: guardian · deployed in: Fly (fiona-guardian) · default: stub
# stub = scenario fixtures until D5 lands.
GUARDIAN_CHECKS_IMPL=

# ── Database ────────────────────────────────────────────────────────────────
# SECRET · used by: engine · deployed in: Fly (fiona-engine)
# Unset locally = Daniyal's portable Postgres 17 (engine.ledger.db).
DATABASE_URL=
# not secret · used by: engine (local Postgres) · deployed in: local only · default: 54329
FIONA_PG_PORT=
# not secret · used by: engine (local Postgres) · deployed in: local only · default: ~/.cache/fiona
# Where the portable Postgres binaries are cached.
FIONA_CACHE_DIR=
# not secret · used by: web · deployed in: Vercel · required: live
# Public by design; protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
# not secret · used by: web · deployed in: Vercel · required: live
# Public by design (anon/publishable key); protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# not secret · used by: engine · deployed in: Fly (fiona-engine) · required: live
SUPABASE_URL=
# not secret · used by: engine · deployed in: Fly (fiona-engine)
SUPABASE_ANON_KEY=
# SECRET · used by: engine only · deployed in: Fly (fiona-engine) · required: live
# Engine only. Never in web, agents or Guardian.
SUPABASE_SERVICE_ROLE_KEY=

# ── Services ────────────────────────────────────────────────────────────────
# not secret · used by: web BFF, agents · deployed in: Vercel, Fly · default: http://localhost:8000
ENGINE_BASE_URL=
# not secret · used by: web BFF · deployed in: Vercel · default: http://localhost:8100
AGENTS_BASE_URL=
# not secret · used by: engine · deployed in: Fly (fiona-engine) · default: http://localhost:8200
GUARDIAN_BASE_URL=
# SECRET · used by: web BFF, engine, agents, guardian · deployed in: Vercel, Fly (all three) · required: live
# Signs the BFF's 60-second internal token.
INTERNAL_JWT_SECRET=
# SECRET · used by: agents → engine · deployed in: Fly (fiona-agents, fiona-engine) · required: live
AGENTS_SERVICE_TOKEN=
# SECRET · used by: engine → guardian · deployed in: Fly (fiona-engine, fiona-guardian) · required: live
# Only the engine's proposals service may call the Guardian.
GUARDIAN_INBOUND_TOKEN=

# ── Claude ──────────────────────────────────────────────────────────────────
# SECRET · used by: agents only · deployed in: Fly (fiona-agents) · required: live
ANTHROPIC_API_KEY=
# SECRET · used by: guardian only · deployed in: Fly (fiona-guardian) · required: live
# Must differ from ANTHROPIC_API_KEY (R8).
GUARDIAN_ANTHROPIC_API_KEY=
# not secret · used by: agents · deployed in: Fly (fiona-agents) · default: claude-haiku-5-5
FIONA_MODEL_EXTRACT=
# not secret · used by: agents · deployed in: Fly (fiona-agents) · default: claude-sonnet-5-5
FIONA_MODEL_REASON=
# not secret · used by: agents · deployed in: Fly (fiona-agents) · default: claude-haiku-5-5
FIONA_MODEL_GUIDE=
# not secret · used by: guardian · deployed in: Fly (fiona-guardian) · default: claude-opus-5-5
FIONA_MODEL_GUARDIAN=
# not secret · used by: guardian · deployed in: Fly (fiona-guardian) · default: 0
# 0 = review every proposal with Opus.
GUARDIAN_ADVERSARIAL_MIN_AMOUNT_MINOR=
# not secret · used by: agents, guardian · deployed in: Fly (fiona-agents, fiona-guardian) · required: live
# Hard stop per run.
LLM_RUN_BUDGET_USD=
# not secret · used by: agents, guardian · deployed in: Fly (fiona-agents, fiona-guardian) · required: live
# Hard stop per day.
LLM_DAILY_BUDGET_USD=
# not secret · used by: agents, guardian · deployed in: Fly · default: 1
# Use the labelled replay cache only when a live call fails.
AGENTS_REPLAY_ENABLED=
# not secret · used by: agents, guardian · deployed in: Fly · default: 0
# Rehearsals and the from-cache run.
AGENTS_FORCE_REPLAY=
# not secret · used by: agents, guardian · deployed in: local only · default: 0
AGENTS_RECORD_REPLAY=

# ── Flags ───────────────────────────────────────────────────────────────────
# not secret · used by: web, agents · deployed in: Vercel, Fly · default: 1
FLAG_COUNCIL=
# not secret · used by: web, agents · deployed in: Vercel, Fly · default: 1
FLAG_GUIDE=
# not secret · used by: web · deployed in: Vercel · default: 1
FLAG_PHONE_PASSKEY=
# not secret · used by: web · deployed in: Vercel · default: 1
FLAG_PERSONA_SWITCH=
# not secret · used by: web · deployed in: Vercel · default: 1
FLAG_FRAMEWORK_LENS=
# not secret · used by: web · deployed in: Vercel · default: 1
FLAG_LAUNCH_LAB=

# ── Demo ────────────────────────────────────────────────────────────────────
# not secret · used by: web, scripts · deployed in: Vercel · default: ten_karachi_apparel
DEMO_TENANT_ID=
# SECRET · used by: web (/demo page) · deployed in: Vercel (demo only)
DEMO_PRESENTER_KEY=
# not secret · used by: web BFF · deployed in: Vercel · default: localhost
# Passkeys are bound to this domain.
WEBAUTHN_RP_ID=
# not secret · used by: web BFF · deployed in: Vercel · default: http://localhost:3000
WEBAUTHN_ORIGIN=
